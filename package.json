{
  "name": "jobgate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm typecheck && prose-lint && ryusenkei-conventions check && go vet ./...",
    "lint:prose": "prose-lint",
    "typecheck": "tsc",
    "test": "go test ./...",
    "check": "pnpm lint && pnpm test",
    "env:push": "node scripts/env.ts push",
    "repo:settings": "node scripts/repo.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@ryusenkei/conventions": "^0.3.1",
    "@ryusenkei/prose-lint": "^0.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.1",
    "cross-spawn": "^7.0.6",
    "typescript": "^5.9.3"
  }
}
