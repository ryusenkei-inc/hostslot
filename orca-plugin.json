{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "hostslot",
  "name": "Hostslot",
  "version": "0.9.0",
  "description": "Machine capacity for parallel agents from Hostslot: what runs and waits, why, how much memory is free, and what a guard stopped.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "apps/orca-plugin/src/main.ts",
  "contributes": {
    "commands": [
      {
        "id": "details",
        "title": "Hostslot: Show details",
        "action": "sidebar.right.toggle"
      }
    ],
    "panels": [
      {
        "id": "details",
        "title": "Hostslot",
        "icon": "gauge",
        "entry": "apps/orca-plugin/src/panel.tsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "capacity",
        "text": "Hostslot",
        "icon": "gauge",
        "tooltip": "Hostslot: starting",
        "command": "details"
      }
    ]
  }
}
