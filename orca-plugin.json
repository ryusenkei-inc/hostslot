{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "hostslot",
  "name": "Hostslot",
  "version": "0.11.1",
  "description": "Schedules what parallel agents share on one machine: heavy commands wait for free memory and CPU, each worktree's dev server gets its own port, and you see what runs, what waits and why.",
  "license": "MIT",
  "icon": "docs/images/icon.png",
  "cover": {
    "path": "docs/images/cover.png",
    "alt": "Hostslot's panel in Orca beside its summary: memory, slots, CPU and GPU; running and waiting jobs; dev servers with their own ports"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "apps/orca-plugin/src/main.ts",
  "contributes": {
    "commands": [
      {
        "id": "details",
        "title": "Hostslot: Show details",
        "action": "sidebar.right.toggle"
      }
    ],
    "panels": [
      {
        "id": "details",
        "title": "Hostslot",
        "icon": "gauge",
        "entry": "apps/orca-plugin/src/panel.tsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "capacity",
        "text": "Hostslot",
        "icon": "gauge",
        "tooltip": "Hostslot: starting",
        "command": "details"
      }
    ]
  }
}
